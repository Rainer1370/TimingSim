      <pv_name>SIM:LASER:PH_ERROR</pv_name>
      <y>25</y>
      <width>188</width>
      <height>49</height>
      <horizontal>true</horizontal>
      <rules>
        <rule name="Color Rule" prop_id="fill_color" out_exp="false">
          <exp bool_exp="pv0&gt;=30 || pv0&lt;=-30">
            <value>
              <color name="MINOR" red="255" green="128" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>$(pv_name)</pv_name>
        </rule>
        <rule name="background" prop_id="background_color" out_exp="false">
          <exp bool_exp="pv0&gt;=50 || pv0&lt;=-50">
            <value>
              <color name="MAJOR" red="255" green="0" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>$(pv_name)</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <limits_from_pv>false</limits_from_pv>
      <minimum>-50.0</minimum>
      <maximum>50.0</maximum>
