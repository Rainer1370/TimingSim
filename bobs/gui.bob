          </color>
        </foreground_color>
      </widget>
      <widget type="checkbox" version="2.0.0">
        <name>Check Box</name>
        <pv_name>SIM:PID:$(G)_MODE</pv_name>
        <label>Override</label>
        <y>30</y>
        <width>110</width>
      </widget>
    </widget>
