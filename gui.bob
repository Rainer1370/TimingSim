        <x>30</x>
        <width>60</width>
        <height>30</height>
        <precision>2</precision>
        <vertical_alignment>1</vertical_alignment>
        <rules>
          <rule name="Enable" prop_id="enabled" out_exp="false">
            <exp bool_exp="pv0==1">
              <value>true</value>
            </exp>
            <pv_name>$(pv_name)_MODE</pv_name>
          </rule>
        </rules>
        <increment>0.01</increment>
        <enabled>false</enabled>
