      <x>90</x>
      <width>66</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </font>
      <precision>2</precision>
      <rules>
        <rule name="Color Rule" prop_id="fill_color" out_exp="false">
          <exp bool_exp="pv0&gt;=40 || pv0&lt;=-40">
            <value>
              <color name="MINOR" red="255" green="128" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>$(pv_name)</pv_name>
        </rule>
        <rule name="background" prop_id="background_color" out_exp="false">
          <exp bool_exp="pv0&gt;=50 || pv0&lt;=-50">
            <value>
              <color name="MAJOR" red="255" green="0" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>$(pv_name)</pv_name>
        </rule>
      </rules>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_23</name>
      <text>Phase Error:</text>
      <height>21</height>
    </widget>
  </widget>
