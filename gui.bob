    <pv_name>SIM:BEAM:DUMP</pv_name>
    <x>95</x>
    <y>60</y>
    <width>100</width>
    <height>30</height>
    <off_label>Enabled</off_label>
    <off_color>
      <color name="On" red="0" green="255" blue="0">
      </color>
    </off_color>
    <on_label>Dumped</on_label>
